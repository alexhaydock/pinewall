# Ignore everything except example config so
# I can use this as my live repo locally while
# avoiding accidentally committing any config
*
!.gitignore
!example.env
!example
!example/etc
!example/etc/corerad
!example/etc/corerad/config.toml
!example/etc/resolv.conf
!example/etc/chrony
!example/etc/chrony/chrony.conf
!example/etc/hostname
!example/etc/init.d
!example/etc/init.d/lockmodules
!example/etc/init.d/enforceperms
!example/etc/init.d/iperf3
!example/etc/nftables.nft
!example/etc/modules
!example/etc/conf.d
!example/etc/conf.d/syslog
!example/etc/conf.d/unbound-exporter
!example/etc/conf.d/dropbear
!example/etc/conf.d/node-exporter
!example/etc/periodic
!example/etc/periodic/daily
!example/etc/periodic/daily/pinehole
!example/etc/network
!example/etc/network/interfaces
!example/etc/nftables.d
!example/etc/nftables.d/rules.nft
!example/etc/profile.d
!example/etc/profile.d/timezone.sh
!example/etc/motd
!example/etc/sysctl.d
!example/etc/sysctl.d/local.conf
!example/etc/ulogd.conf
!example/etc/hosts
!example/etc/unbound
!example/etc/unbound/unbound.conf
!example/etc/unbound/adblock.list
!example/etc/kea
!example/etc/kea/kea-dhcp4.conf
!example/root
!example/root/.ssh
!example/root/.ssh/authorized_keys
!example/root/.config
!example/root/.config/htop
!example/root/.config/htop/htoprc
